# Razorpay TEST mode credentials only (rzp_test_...). Never commit real values.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Buyer agent LLM, called through LiteLLM (defaults to Claude)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Anthropic key from https://console.anthropic.com/
LLM_API_KEY=sk-ant-xxxx
# Optional: route through a LiteLLM proxy gateway instead (litellm --config litellm_config.yaml).
# Then LLM_MODEL is the proxy's model alias and LLM_API_KEY is the proxy key.
LLM_API_BASE=
# razorpay = real Razorpay TEST API | fake = offline stand-in (tests, evals, no-network demos)
PAYMENT_GATEWAY=razorpay

# App
DATABASE_URL=sqlite:///./visala_demo.db
# Where the webhook/approval app is reachable. Webhooks need a public URL (e.g. an ngrok tunnel);
# the approval page and the payment callback work on localhost.
PUBLIC_BASE_URL=http://localhost:8000

# Guardrails
MAX_ORDER_AMOUNT_INR=2000
MAX_DAILY_AMOUNT_INR=5000
REQUIRE_USER_CONFIRMATION=true
